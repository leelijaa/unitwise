{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "unitwise/popular-converters",
  "version": "1.0.0",
  "title": "UnitWise Popular Converters",
  "category": "unitwise",
  "description": "Grid of converter links for hub and silo landing pages.",
  "keywords": [ "popular", "converters", "grid", "hub" ],
  "textdomain": "unitwise-converters",
  "attributes": {
    "category": {
      "type": "string",
      "default": "weight"
    },
    "limit": {
      "type": "number",
      "default": 12
    },
    "title": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "unitwise-blocks-editor",
  "render": "file:./render.php",
  "style": "file:./style.css"
}
